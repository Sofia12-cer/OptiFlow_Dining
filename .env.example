# Genera una clave segura con: python scripts/generate_env.py
DJANGO_SECRET_KEY=REEMPLAZAR_POR_CLAVE_ALEATORIA
DJANGO_DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=0
# Usuarios de demostración: activar solamente en entorno de desarrollo
ENABLE_DEMO_USERS=0
DEMO_PASSWORD=REEMPLAZAR_POR_CONTRASENA_SEGURA
# Administrador inicial: solo se crea si no existe y ADMIN_PASSWORD tiene 12+ caracteres.
# Nunca se sobrescribe la clave de un admin existente. Alternativa: manage.py createsuperuser
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# AWS opcional. Bucket vacío = S3 desactivado (las fotos quedan solo en el servidor).
# Credenciales: rol IAM de EC2 (recomendado), ~/.aws/credentials o las claves de abajo. No subirlas a Git.
AWS_STORAGE_BUCKET_NAME=optiflow-dining-cloud-storage
AWS_S3_BUCKET=optiflow-dining-cloud-storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
